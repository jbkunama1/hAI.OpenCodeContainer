# .env — API keys & optional secrets
# Kopiere nach .env und trage deine Werte ein. KEINE Secrets committen.

# Server Configuration
CODE_PASSWORD=DeinSehrStarkesPasswort
OPENCODE_PORT=8076
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GH_TOKEN=

# Custom Endpoints
LOCAL_ENDPOINT=http://localhost:8000/v1  # Your OpenAI-compatible endpoint
CUSTOM_OPENAI_ENDPOINT=http://localhost:8000/v1  # Custom OpenAI-compatible endpoint
CUSTOM_MCP_ENDPOINT=http://localhost:9000  # Your custom MCP server endpoint

# Directories
OPENCODE_DATA_DIR=~/opencode/data
OPENCODE_PROJECTS_DIR=~/opencode/projects

# Timezone
TZ=Europe/Berlin