FROM jbkunama1/hai.opencodecontainer:latest

# Install Python and MCP dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages
COPY requirements-mcp.txt /app/requirements-mcp.txt
RUN pip3 install --no-cache-dir -r /app/requirements-mcp.txt

# Copy MCP server
COPY mcp_server.py /app/mcp_server.py

# Make the script executable
RUN chmod +x /app/mcp_server.py

# Create startup script
RUN echo '#!/bin/sh' > /app/start.sh && \
    echo 'echo "Starting OpenCode MCP Server"' >> /app/start.sh && \
    echo 'python3 /app/mcp_server.py &' >> /app/start.sh && \
    echo 'opencode web --port 8076 --hostname 0.0.0.0' >> /app/start.sh && \
    chmod +x /app/start.sh

# Expose ports
EXPOSE 8076 9000 9001

WORKDIR /app
CMD ["/app/start.sh"]