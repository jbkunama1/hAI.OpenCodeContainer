FROM python:3.11-slim

# Install opencode dependencies
RUN apt-get update && apt-get install -y \
    curl \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Install opencode globally
RUN npm install -g opencode-ai

# Create workspace directory
RUN mkdir -p /root/.local/share/opencode /workspace

# Install Python and MCP dependencies
RUN pip3 install --no-cache-dir flask flask-cors pyjwt python-dotenv requests

# Copy MCP server
COPY mcp_server.py /app/mcp_server.py
COPY requirements-mcp.txt /app/requirements-mcp.txt
RUN pip3 install --no-cache-dir -r /app/requirements-mcp.txt

# Make the script executable
RUN chmod +x /app/mcp_server.py

# Expose ports
EXPOSE 8076 9000 9001

WORKDIR /app

# Start command: MCP server in background, then OpenCode web
CMD ["sh", "-c", "python3 /app/mcp_server.py & opencode web --port 8076 --hostname 0.0.0.0"]